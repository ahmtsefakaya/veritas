generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm, ILIKE '%...%' aramalarinin indeksten faydalanmasi icin gerekli.
  // Btree bir indeks ortadaki joker karakterli ILIKE'i kullanamaz; GIN + trgm
  // kullanabilir. Arama /topics listesinin en pahali durumuydu.
  extensions = [pg_trgm]
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum TopicStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum SidePosition {
  A
  B
}

enum UserTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String   @unique
  displayName       String?
  passwordHash      String
  avatarUrl         String?
  bio               String?
  role              UserRole @default(USER)
  reputationScore   Int      @default(0)
  totalEarnings     Decimal  @default(0) @db.Decimal(12, 2)
  pointsBalance     Int      @default(0)
  country           String?
  isPremium         Boolean  @default(false)
  premiumUntil      DateTime?
  refreshTokenHash  String?
  isEmailVerified   Boolean  @default(false)
  isBanned          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  topics    Topic[]
  evidences Evidence[]
  votes     EvidenceVote[]
  comments  Comment[]
  pointTransactions PointTransaction[]
  notifications     Notification[]
  evidenceReports   EvidenceReport[]
  tokens            UserToken[]

  @@map("users")
}

/// Tek kullanimlik hesap islemi jetonlari (e-posta dogrulama, sifre sifirlama).
/// Yalnizca SHA-256 ozeti saklanir; duz jeton sadece e-posta ile kullaniciya gider.
model UserToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@map("user_tokens")
}

model PointTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  sourceKey String   @unique
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("point_transactions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model EvidenceReport {
  id         String   @id @default(uuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  detail     String?
  status     String   @default("PENDING")
  resolution String?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@unique([evidenceId, reporterId])
  @@index([status, createdAt])
  @@map("evidence_reports")
}

model Topic {
  id              String      @id @default(uuid())
  title           String
  description     String
  category        String
  status          TopicStatus @default(PENDING)
  moderationNote  String?
  creatorId       String
  creator         User        @relation(fields: [creatorId], references: [id])
  sides           Side[]
  comments        Comment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Liste sorgusu daima status'e gore filtreler ve createdAt/updatedAt'e gore
  // siralar. Bu bilesik indeksler hem filtreyi hem siralamayi karsilar, boylece
  // 4000+ satirin seq scan + sort maliyeti ortadan kalkar.
  @@index([status, createdAt])
  @@index([status, updatedAt])
  // Kategori filtresi (buyuk/kucuk harf duyarsiz esitlik) icin trgm; btree
  // ILIKE'i kullanamazdi.
  @@index([category(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([creatorId])
  @@map("topics")
}

model Comment {
  id        String    @id @default(uuid())
  topicId   String
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  content   String
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([topicId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Side {
  id        String       @id @default(uuid())
  topicId   String
  topic     Topic        @relation(fields: [topicId], references: [id])
  position  SidePosition
  label     String
  evidences Evidence[]

  @@unique([topicId, position])
  // Arama, taraf etiketinde de ILIKE '%...%' yapiyor ve 10.000 satiri tariyordu.
  @@index([label(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("sides")
}

model Evidence {
  id          String   @id @default(uuid())
  sideId      String
  side        Side     @relation(fields: [sideId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  content     String
  sourceUrl   String?
  score       Int?
  aiReasoning String?
  qualityBreakdown Json?
  createdAt   DateTime @default(now())

  votes EvidenceVote[]
  reports EvidenceReport[]

  // EN KRITIK INDEKS: /topics listesi her istekte ic ice kanitlari
  // "WHERE sideId IN (...)" ile cekiyordu ve indeks olmadigi icin 45.000
  // satirlik tabloyu bastan sona tariyordu (seq scan, ~400 ms).
  // (sideId, score) bilesik olmasi dava detayindaki "score desc" siralamasini
  // da karsilar.
  @@index([sideId, score])
  // Profil/itibar sorgulari kanitlari yazara gore topluyor.
  @@index([authorId])
  @@map("evidences")
}

model EvidenceVote {
  id         String   @id @default(uuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([evidenceId, userId])
  @@index([evidenceId])
  @@map("evidence_votes")
}
